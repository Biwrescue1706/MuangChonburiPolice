generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/neon"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  adminId   String    @id @default(uuid())
  username  String    @unique
  password  String
  name      String
  position  String
  createdAt DateTime  @default(now())
  updatedAt DateTime?
}

model OrganizationCommander {
  commanderId      String    @id @default(uuid())
  organizationId   String    @unique
  rank             String?
  fullRank         String?
  firstName        String?
  lastName         String?
  fullName         String?
  fullNameWithRank String?
  position         String?
  fullPosition     String?
  signatureImage   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime?

  organization Organization @relation(fields: [organizationId], references: [organizationId])
}

model OrganizationFinance {
  financeId        String    @id @default(uuid())
  organizationId   String    @unique
  rank             String?
  firstName        String?
  lastName         String?
  fullName         String?
  fullNameWithRank String?
  position         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime?

  organization Organization @relation(fields: [organizationId], references: [organizationId])
}

model Organization {
  organizationId   String    @id @default(uuid())
  key              String    @unique @default("MAIN")
  organizationName String
  rank             String?
  firstName        String
  lastName         String
  fullName         String
  fullNameWithRank String
  position         String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime?

  commander OrganizationCommander?
  finance   OrganizationFinance?

  persons  Person[]
  receipts Receipt[]
}

model Person {
  personId  String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime?

  prefix    String
  firstName String
  lastName  String
  fullName  String
  citizenId String

  birthDate  String?
  birthDay   String?
  birthMonth String?
  birthYear  String?

  nationality String?
  ethnicity   String?

  weight Int?
  height Int?

  bodyType            String? @default("สันทัด")
  skinColor           String? @default("ดำแดง")
  behavior            String? @default("ปกติ")
  distinguishingMarks String? @default("-")

  address          String?
  occupation       String?
  workplaceAddress String?

  father String?
  mother String?
  spouse String? @default("-")

  fingerprintDate String?

  purpose          String?
  requestingAgency String?

  receiptBookNo String?
  receiptNo     String?
  receiptDate   String?

  money     Int     @default(100)
  moneyText String?

  // 0 = รอส่ง ศพฐ.
  // 1 = เตรียมเอกสารส่ง ศพฐ. แล้ว
  // 2 = ส่ง ศพฐ. แล้ว
  // 3 = รับจาก ศพฐ. แล้ว
  // 4 = ส่งคืนต้นสังกัดแล้ว
  status Int @default(0)

  statusUpdatedAt DateTime?
  deleteAt        DateTime?

  organizationId   String?
  organizationName String?
  fullNameOrg      String?

  rank             String?
  position         String?
  fullNameWithRank String?

  priority Int @default(0)

  returnDate DateTime?

  organization Organization? @relation(fields: [organizationId], references: [organizationId])

  receipts Receipt[]

  requestInfos RequestInfo[]

  statusHistories PersonStatusHistory[]

  forensicSubmissionPersons ForensicSubmissionPerson[]
}

model PersonStatusHistory {
  historyId String @id @default(uuid())
  personId  String

  oldStatus Int
  newStatus Int

  changedAt DateTime @default(now())

  person Person @relation(fields: [personId], references: [personId], onDelete: Cascade)

  @@index([personId])
  @@index([oldStatus, newStatus])
  @@index([changedAt])
}

model RequestInfo {
  requestInfoId    String   @id @default(uuid())
  personId         String
  purpose          String?
  requestingAgency String?
  createdAt        DateTime @default(now())

  person Person @relation(fields: [personId], references: [personId], onDelete: Cascade)
}

model Receipt {
  receiptId String  @id @default(uuid())
  personId  String?

  prefix    String
  firstName String
  lastName  String
  fullName  String

  organizationId   String?
  organizationName String?
  fullNameOrg      String?

  rank             String?
  position         String?
  fullNameWithRank String?

  receiptBookNo String?
  receiptNo     String?
  receiptDate   String?

  money     Int
  moneyText String?

  createdAt DateTime @default(now())
  priority  Int      @default(0)

  organization Organization? @relation(fields: [organizationId], references: [organizationId])

  person Person? @relation(fields: [personId], references: [personId], onDelete: Cascade)
}

model ForensicSubmission {
  submissionId   String   @id @default(uuid())
  submissionNo   String?
  submissionDate DateTime @default(now())
  createdAt      DateTime @default(now())

  // 0 = รอส่ง ศพฐ.
  // 1 = เตรียมเอกสารส่ง ศพฐ. แล้ว
  // 2 = ส่ง ศพฐ. แล้ว
  // 3 = รับจาก ศพฐ. แล้ว
  // 4 = ส่งคืนต้นสังกัดแล้ว
  status          Int       @default(0)
  statusUpdatedAt DateTime?

  persons ForensicSubmissionPerson[]

  statusHistories ForensicSubmissionStatusHistory[]
}

model ForensicSubmissionPerson {
  id           String @id @default(uuid())
  submissionId String
  personId     String

  submission ForensicSubmission @relation(fields: [submissionId], references: [submissionId], onDelete: Cascade)

  person Person @relation(fields: [personId], references: [personId], onDelete: Cascade)

  @@unique([submissionId, personId])
  @@index([submissionId])
  @@index([personId])
}

model ForensicSubmissionStatusHistory {
  historyId    String @id @default(uuid())
  submissionId String

  oldStatus Int
  newStatus Int

  remark    String?
  changedBy String?

  changedAt DateTime @default(now())

  submission ForensicSubmission @relation(fields: [submissionId], references: [submissionId], onDelete: Cascade)

  @@index([submissionId])
  @@index([changedAt])
}

model organizationpersonnel {
  personnelId String @id @default(uuid())

  rank             String?
  firstName        String
  lastName         String
  fullName         String
  fullNameWithRank String

  position String?
  duty     String?
  phone    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime?
}

model Foreigner {
  id String @id @default(uuid())

  sequenceNo Int? // ลำดับ
  year       Int? // ปี พ.ศ. ของรายการ

  foreignerIdNo             String? //เลขรหัสคนต่างด้าว
  prefix                    String? // คำนำหน้า
  firstName                 String // ชื่อ
  lastName                  String // นามสกุล
  fullName                  String // ชื่อเต็ม
  age                       Int? //อายุ
  nationality               String? //สัญชาติ
  ethnicity                 String? //เชื้อชาติ
  certificateRegistrationNo String? //เลขทะเบียนของใบสำคัญ
  certificateDate           String? //วัน เดือน ปี ของใบสำคัญ เก็บเป็น String
  district                  String? // ออกให้ ณ อำเภอ
  province                  String? // ออกให้ ณ จังหวัด

  policeStation  String? // สถานีตำรวจ
  policeProvince String? // จังหวัดของสถานีตำรวจ

  // ภูมิลำเนา
  houseNo          String? // บ้านเลขที่
  moo              String? // หมู่
  road             String? // ถนน
  subdistrict      String? // ตำบล
  domicileDistrict String? // อำเภอ
  domicileProvince String? // จังหวัด

  domicile String? // ที่อยู่รวม บ้านเลขที่ + หมู่ + ถนน + ตำบล + อำเภอ + จังหวัด

  applicationType        String? // การขอรับใหม่ / ขอรับใบแทน / ขอต่ออายุ เก็บเป็น String
  applicationDate        String? //วันเริ่มต่ออายุ เก็บเป็น String
  expirationDate         String? //วันที่หมดอายุ เก็บเป็น String
  previousExpirationDate String? // วันหมดอายุก่อนต่ออายุ

  amount        Int? // ค่าธรรมเนียม
  amountText    String? // ค่าธรรมเนียมแบบตัวอักษร
  receiptBookNo String? // ใบเสร็จเล่มที่
  receiptNo     String? //ใบเสร็จเลขที่
  receiptDate   String? // วันเดือนปี ของใบเสร็จ เก็บเป็น String
  certificateNo String? // ใบสำคัญ
  petitionDate  DateTime? @db.Date // วันที่ยื่นคำร้อง

  // ระบบ
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([foreignerIdNo])
  @@index([fullName])
  @@index([certificateRegistrationNo])
  @@index([certificateNo])
  @@index([receiptNo])
  @@index([applicationDate])
  @@index([expirationDate])
  @@index([petitionDate])
}
