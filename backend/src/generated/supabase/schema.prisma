generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/supabase"
}

datasource db {
  provider = "postgresql"
}

model Foreigner {
  id String @id @default(uuid())

  // ลำดับ
  sequenceNo Int?

  // ข้อมูลบุคคล
  foreignerIdNo String? // รหัสประจำตัวคนต่างด้าว
  name          String // ชื่อ แซ่
  age           Int? // อายุ
  nationality   String? // สัญชาติ
  ethnicity     String? // เชื้อชาติ

  // ใบสำคัญ
  certificateRegistrationNo String? // เลขทะเบียนของใบสำคัญ
  certificateDate           DateTime? @db.Date // วัน เดือน ปี ของใบสำคัญ

  //ออกให้ ณ 
  district String? // อำเภอ
  province String? // จังหวัด

  domicile String? // ภูมิลำเนา

  // การขอรับใหม่ / ขอรับใบแทน / ขอต่ออายุ
  applicationDate DateTime? @db.Date

  // วันหมดอายุ
  expirationDate DateTime? @db.Date

  // ค่าธรรมเนียม
  amount Decimal?

  // ใบเสร็จ
  receiptBookNo String? // ใบเสร็จเล่มที่
  receiptNo     String? // ใบเสร็จเลขที่
  receiptDate   DateTime? @db.Date // วัน เดือน ปี ของใบเสร็จ

  // ใบสำคัญ
  certificateNo String? // เลขใบสำคัญฯ

  // วันที่ยื่นคำร้อง
  petitionDate DateTime? @db.Date

  // ระบบ
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([foreignerIdNo])
  @@index([name])
  @@index([certificateRegistrationNo])
  @@index([certificateNo])
  @@index([receiptNo])
  @@index([applicationDate])
  @@index([expirationDate])
  @@index([petitionDate])
}
