generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/supabase"
}

datasource db {
  provider = "postgresql"
}

model Foreigner {
  id String @id @default(uuid())

  // ลำดับ
  sequenceNo Int?

  // ปี พ.ศ. ของรายการ
  year Int?

  // =========================
  // ข้อมูลบุคคล
  // =========================

  foreignerIdNo String?
  name          String
  age           Int?
  nationality   String?
  ethnicity     String?

  // =========================
  // ใบสำคัญ
  // =========================

  certificateRegistrationNo String?

  // เก็บเป็น String
  certificateDate String?

  // =========================
  // ออกให้ ณ
  // =========================

  district String?
  province String?

  // =========================
  // ภูมิลำเนา
  // =========================

  domicile String?

  // =========================
  // การขอรับใหม่ / ขอรับใบแทน / ขอต่ออายุ
  // =========================

  applicationType String?

  // เก็บเป็น String
  applicationDate String?

  // เก็บเป็น String
  expirationDate String?

  // =========================
  // ค่าธรรมเนียม
  // =========================

  amount Decimal?

  // =========================
  // ใบเสร็จ
  // =========================

  receiptBookNo String?
  receiptNo     String?

  // เก็บเป็น String
  receiptDate String?

  // =========================
  // ใบสำคัญ
  // =========================

  certificateNo String?

  // วันที่ยื่นคำร้อง
  petitionDate DateTime? @db.Date

  // =========================
  // ระบบ
  // =========================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([foreignerIdNo])
  @@index([name])
  @@index([certificateRegistrationNo])
  @@index([certificateNo])
  @@index([receiptNo])
  @@index([applicationDate])
  @@index([expirationDate])
  @@index([petitionDate])
}
